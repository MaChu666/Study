	<!--实体映射-->
	<resultMap id="base_result_map" type="com.machugit.entity.po.VideoAuditLog">
		<!--审核id-->
		<result column="audit_id" property="auditId"  />
		<!--视频id-->
		<result column="video_id" property="videoId"  />
		<!--审核人id-->
		<result column="auditor_id" property="auditorId"  />
		<!--变更前状态-->
		<result column="from_status" property="fromStatus"  />
		<!--变更后状态-->
		<result column="to_status" property="toStatus"  />
		<!--审核原因-->
		<result column="reason" property="reason"  />
		<!--创建时间-->
		<result column="create_time" property="createTime"  />
	</resultMap>


	<!-- 通用查询结果列-->
	<sql id="base_column_list">
		 a.audit_id,a.video_id,a.auditor_id,a.from_status,a.to_status,
		 a.reason,a.create_time
	</sql>

	<sql id="base_condition_filed">
			<if test="query.auditId != null">
				 and  a.audit_id = #{query.auditId}
			</if>
			<if test="query.videoId != null and query.videoId!=''">
				 and  a.video_id = #{query.videoId}
			</if>
			<if test="query.auditorId != null and query.auditorId!=''">
				 and  a.auditor_id = #{query.auditorId}
			</if>
			<if test="query.fromStatus != null">
				 and  a.from_status = #{query.fromStatus}
			</if>
			<if test="query.toStatus != null">
				 and  a.to_status = #{query.toStatus}
			</if>
			<if test="query.reason != null and query.reason!=''">
				 and  a.reason = #{query.reason}
			</if>
			<if test="query.createTime != null and query.createTime!=''">
				 <![CDATA[ and  a.create_time=str_to_date(#{query.createTime}, '%Y-%m-%d') ]]>
			</if>
	</sql>

	<!-- 通用查询条件列-->
	<sql id="query_condition">
	 <where>
			<include refid="base_condition_filed" />
			<if test="query.reasonFuzzy!= null  and query.reasonFuzzy!=''">
				 and  a.reason like concat('%', #{query.reasonFuzzy}, '%')
			</if>
			<if test="query.createTimeStart!= null and query.createTimeStart!=''">
				 <![CDATA[ and  a.create_time>=str_to_date(#{query.createTimeStart}, '%Y-%m-%d') ]]>
			</if>
			<if test="query.createTimeEnd!= null and query.createTimeEnd!=''">
				 <![CDATA[ and  a.create_time< date_sub(str_to_date(#{query.createTimeEnd},'%Y-%m-%d'),interval -1 day) ]]>
			</if>
	 </where>
	</sql>

	<!-- 查询集合-->
	<select id="selectList" resultMap="base_result_map" >
		 SELECT <include refid="base_column_list" /> FROM video_audit_log a <include refid="query_condition" />
		 <if test="query.orderBy!=null">
			 order by ${query.orderBy}
		 </if>
		 <if test="query.simplePage!=null">
			 limit #{query.simplePage.start},#{query.simplePage.end}
		 </if>
	</select>

