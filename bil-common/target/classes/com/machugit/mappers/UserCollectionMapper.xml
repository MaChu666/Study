	<!-- 根据PrimaryKey获取对象-->
	<select id="selectByCollectionId" resultMap="base_result_map" >
		select <include refid="base_column_list" /> from user_collection c where collection_id=#{collectionId}
	</select>

	<!-- 根据UserId修改-->
	<update id="updateByUserId" parameterType="com.machugit.entity.po.UserCollection">
		 UPDATE user_collection
 		 <set>
			<if test="bean.collectionId != null">
