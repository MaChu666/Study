			</if>
		 </trim>
	</insert>

	<!-- 添加 （批量插入）-->
	<insert id="insertBatch" parameterType="com.machugit.entity.po.UserCollection">
		 INSERT INTO user_collection(
			 collection_id,
			 user_id,
			 video_id,
			 create_time
		 )values
		 <foreach collection="list" item="item" separator=",">
			 (
				 #{item.collectionId},
				 #{item.userId},
				 #{item.videoId},
				 #{item.createTime}
			 )
		 </foreach>
	</insert>

	<!-- 批量新增修改 （批量插入）-->
	<insert id="insertOrUpdateBatch" parameterType="com.machugit.entity.po.UserCollection">
