	<!--实体映射-->
	<resultMap id="base_result_map" type="com.machugit.entity.po.CommentInfo">
		<!--评论id-->
		<result column="comment_id" property="commentId"  />
		<!--视频id-->
		<result column="video_id" property="videoId"  />
		<!--用户id-->
		<result column="user_id" property="userId"  />
		<!--评论内容-->
		<result column="content" property="content"  />
		<!--回复评论id-->
		<result column="reply_comment_id" property="replyCommentId"  />
		<!--图片路径-->
		<result column="img_path" property="imgPath"  />
		<!--置顶类型-->
		<result column="top_type" property="topType"  />
		<!--创建时间-->
		<result column="create_time" property="createTime"  />
	</resultMap>


	<!-- 通用查询结果列-->
	<sql id="base_column_list">
		 c.comment_id,c.video_id,c.user_id,c.content,c.reply_comment_id,
		 c.img_path,c.top_type,c.create_time
	</sql>

	<sql id="base_condition_filed">
			<if test="query.commentId != null">
				 and  c.comment_id = #{query.commentId}
			</if>
			<if test="query.videoId != null and query.videoId!=''">
				 and  c.video_id = #{query.videoId}
			</if>
			<if test="query.userId != null and query.userId!=''">
				 and  c.user_id = #{query.userId}
			</if>
			<if test="query.content != null and query.content!=''">
				 and  c.content = #{query.content}
			</if>
			<if test="query.replyCommentId != null">
				 and  c.reply_comment_id = #{query.replyCommentId}
			</if>
			<if test="query.imgPath != null and query.imgPath!=''">
				 and  c.img_path = #{query.imgPath}
			</if>
			<if test="query.topType != null">
				 and  c.top_type = #{query.topType}
			</if>
			<if test="query.createTime != null and query.createTime!=''">
				 <![CDATA[ and  c.create_time=str_to_date(#{query.createTime}, '%Y-%m-%d') ]]>
			</if>
	</sql>

	<!-- 通用查询条件列-->
	<sql id="query_condition">
	 <where>
			<include refid="base_condition_filed" />
			<if test="query.contentFuzzy!= null  and query.contentFuzzy!=''">
				 and  c.content like concat('%', #{query.contentFuzzy}, '%')
			</if>
			<if test="query.createTimeStart!= null and query.createTimeStart!=''">
				 <![CDATA[ and  c.create_time>=str_to_date(#{query.createTimeStart}, '%Y-%m-%d') ]]>
			</if>
			<if test="query.createTimeEnd!= null and query.createTimeEnd!=''">
				 <![CDATA[ and  c.create_time< date_sub(str_to_date(#{query.createTimeEnd},'%Y-%m-%d'),interval -1 day) ]]>
			</if>
	 </where>
	</sql>

	<!-- 查询集合-->
	<select id="selectList" resultMap="base_result_map" >
		 SELECT <include refid="base_column_list" /> FROM comment_info c <include refid="query_condition" />
		 <if test="query.orderBy!=null">
			 order by ${query.orderBy}
		 </if>
		 <if test="query.simplePage!=null">
			 limit #{query.simplePage.start},#{query.simplePage.end}
		 </if>
	</select>

	<!-- 查询数量-->
	<select id="selectCount" resultType="java.lang.Integer" >
