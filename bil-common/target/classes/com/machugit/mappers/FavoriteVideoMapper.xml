	<!--实体映射-->
	<resultMap id="base_result_map" type="com.machugit.entity.po.FavoriteVideo">
		<!--记录id-->
		<result column="id" property="id"  />
		<!--收藏夹id-->
		<result column="folder_id" property="folderId"  />
		<!--用户id-->
		<result column="user_id" property="userId"  />
		<!--视频id-->
		<result column="video_id" property="videoId"  />
		<!--创建时间-->
		<result column="create_time" property="createTime"  />
	</resultMap>


	<!-- 通用查询结果列-->
	<sql id="base_column_list">
		 v.id,v.folder_id,v.user_id,v.video_id,v.create_time
	</sql>

	<sql id="base_condition_filed">
			<if test="query.id != null">
				 and  v.id = #{query.id}
			</if>
			<if test="query.folderId != null">
				 and  v.folder_id = #{query.folderId}
			</if>
			<if test="query.userId != null and query.userId!=''">
				 and  v.user_id = #{query.userId}
			</if>
			<if test="query.videoId != null and query.videoId!=''">
				 and  v.video_id = #{query.videoId}
			</if>
			<if test="query.createTime != null and query.createTime!=''">
				 <![CDATA[ and  v.create_time=str_to_date(#{query.createTime}, '%Y-%m-%d') ]]>
			</if>
	</sql>

	<!-- 通用查询条件列-->
	<sql id="query_condition">
	 <where>
			<include refid="base_condition_filed" />
			<if test="query.createTimeStart!= null and query.createTimeStart!=''">
				 <![CDATA[ and  v.create_time>=str_to_date(#{query.createTimeStart}, '%Y-%m-%d') ]]>
			</if>
			<if test="query.createTimeEnd!= null and query.createTimeEnd!=''">
				 <![CDATA[ and  v.create_time< date_sub(str_to_date(#{query.createTimeEnd},'%Y-%m-%d'),interval -1 day) ]]>
			</if>
	 </where>
	</sql>

	<!-- 查询集合-->
	<select id="selectList" resultMap="base_result_map" >
		 SELECT <include refid="base_column_list" /> FROM favorite_video v <include refid="query_condition" />
		 <if test="query.orderBy!=null">
			 order by ${query.orderBy}
		 </if>
		 <if test="query.simplePage!=null">
			 limit #{query.simplePage.start},#{query.simplePage.end}
		 </if>
	</select>

	<!-- 查询数量-->
	<select id="selectCount" resultType="java.lang.Integer" >
