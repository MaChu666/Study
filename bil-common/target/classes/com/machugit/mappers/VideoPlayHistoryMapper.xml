<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.machugit.mappers.VideoPlayHistoryMapper">

	<!--实体映射-->
	<resultMap id="base_result_map" type="com.machugit.entity.po.VideoPlayHistory">
		<!--播放记录id-->
		<result column="history_id" property="historyId"  />
		<!--视频id-->
		<result column="video_id" property="videoId"  />
		<!--用户id-->
		<result column="user_id" property="userId"  />
		<!--文件id-->
		<result column="file_id" property="fileId"  />
		<!--更新时间-->
		<result column="update_time" property="updateTime"  />
	</resultMap>


	<!-- 通用查询结果列-->
	<sql id="base_column_list">
		 h.history_id,h.video_id,h.user_id,h.file_id,h.update_time
	</sql>

	<sql id="base_condition_filed">
			<if test="query.historyId != null">
				 and  h.history_id = #{query.historyId}
			</if>
			<if test="query.videoId != null and query.videoId!=''">
				 and  h.video_id = #{query.videoId}
			</if>
			<if test="query.userId != null and query.userId!=''">
				 and  h.user_id = #{query.userId}
			</if>
			<if test="query.fileId != null and query.fileId!=''">
				 and  h.file_id = #{query.fileId}
			</if>
			<if test="query.updateTime != null and query.updateTime!=''">
				 <![CDATA[ and  h.update_time=str_to_date(#{query.updateTime}, '%Y-%m-%d') ]]>
			</if>
	</sql>

	<!-- 通用查询条件列-->
	<sql id="query_condition">
	 <where>
			<include refid="base_condition_filed" />
			<if test="query.updateTimeStart!= null and query.updateTimeStart!=''">
				 <![CDATA[ and  h.update_time>=str_to_date(#{query.updateTimeStart}, '%Y-%m-%d') ]]>
			</if>
			<if test="query.updateTimeEnd!= null and query.updateTimeEnd!=''">
				 <![CDATA[ and  h.update_time< date_sub(str_to_date(#{query.updateTimeEnd},'%Y-%m-%d'),interval -1 day) ]]>
			</if>
	 </where>
	</sql>

	<!-- 查询集合-->
	<select id="selectList" resultMap="base_result_map" >
		 SELECT <include refid="base_column_list" /> FROM video_play_history h <include refid="query_condition" />
		 <if test="query.orderBy!=null">
			 order by ${query.orderBy}
		 </if>
		 <if test="query.simplePage!=null">
			 limit #{query.simplePage.start},#{query.simplePage.end}
		 </if>
	</select>

	<!-- 查询数量-->
	<select id="selectCount" resultType="java.lang.Integer" >
		 SELECT count(1) FROM video_play_history h <include refid="query_condition" />
	</select>

	<!-- 插入 （匹配有值的字段）-->
	<insert id="insert" parameterType="com.machugit.entity.po.VideoPlayHistory">
		 INSERT INTO video_play_history
		 <trim prefix="(" suffix=")" suffixOverrides="," >
			<if test="bean.historyId != null">
				 history_id,
			</if>
			<if test="bean.videoId != null">
				 video_id,
			</if>
			<if test="bean.userId != null">
				 user_id,
			</if>
			<if test="bean.fileId != null">
				 file_id,
			</if>
			<if test="bean.updateTime != null">
				 update_time,
			</if>
		 </trim>
		 <trim prefix="values (" suffix=")" suffixOverrides="," >
			<if test="bean.historyId!=null">
				 #{bean.historyId},
			</if>
			<if test="bean.videoId!=null">
				 #{bean.videoId},
			</if>
			<if test="bean.userId!=null">
				 #{bean.userId},
			</if>
			<if test="bean.fileId!=null">
				 #{bean.fileId},
			</if>
			<if test="bean.updateTime!=null">
				 #{bean.updateTime},
			</if>
		 </trim>
	</insert>

	<!-- 插入或者更新 （匹配有值的字段）-->
	<insert id="insertOrUpdate" parameterType="com.machugit.entity.po.VideoPlayHistory">
		 INSERT INTO video_play_history
		 <trim prefix="(" suffix=")" suffixOverrides=",">
			<if test="bean.historyId != null">
				 history_id,
			</if>
			<if test="bean.videoId != null">
				 video_id,
			</if>
			<if test="bean.userId != null">
				 user_id,
			</if>
			<if test="bean.fileId != null">
				 file_id,
			</if>
			<if test="bean.updateTime != null">
				 update_time,
			</if>
		 </trim>
		 <trim prefix="values (" suffix=")" suffixOverrides=",">
			<if test="bean.historyId!=null">
				 #{bean.historyId},
			</if>
			<if test="bean.videoId!=null">
				 #{bean.videoId},
			</if>
			<if test="bean.userId!=null">
				 #{bean.userId},
			</if>
			<if test="bean.fileId!=null">
				 #{bean.fileId},
			</if>
			<if test="bean.updateTime!=null">
				 #{bean.updateTime},
			</if>
		 </trim>
		 on DUPLICATE key update
		 <trim prefix="" suffix="" suffixOverrides=",">
			<if test="bean.historyId!=null">
				 history_id = VALUES(history_id),
			</if>
			<if test="bean.videoId!=null">
				 video_id = VALUES(video_id),
			</if>
			<if test="bean.userId!=null">
				 user_id = VALUES(user_id),
			</if>
			<if test="bean.fileId!=null">
				 file_id = VALUES(file_id),
			</if>
			<if test="bean.updateTime!=null">
				 update_time = VALUES(update_time),
			</if>
		 </trim>
	</insert>

	<!-- 添加 （批量插入）-->
	<insert id="insertBatch" parameterType="com.machugit.entity.po.VideoPlayHistory">
		 INSERT INTO video_play_history(
			 history_id,
			 video_id,
			 user_id,
			 file_id,
			 update_time
		 )values
		 <foreach collection="list" item="item" separator=",">
			 (
				 #{item.historyId},
				 #{item.videoId},
				 #{item.userId},
				 #{item.fileId},
				 #{item.updateTime}
			 )
		 </foreach>
	</insert>

	<!-- 批量新增修改 （批量插入）-->
	<insert id="insertOrUpdateBatch" parameterType="com.machugit.entity.po.VideoPlayHistory">
		 INSERT INTO video_play_history(
			 history_id,
			 video_id,
			 user_id,
			 file_id,
			 update_time
		 )values
		 <foreach collection="list" item="item" separator=",">
			 (
				 #{item.historyId},
				 #{item.videoId},
				 #{item.userId},
				 #{item.fileId},
				 #{item.updateTime}
			 )
		 </foreach>
			on DUPLICATE key update
			history_id = VALUES(history_id),
			video_id = VALUES(video_id),
			user_id = VALUES(user_id),
			file_id = VALUES(file_id),
			update_time = VALUES(update_time)
	</insert>

	<!--多条件修改-->
	<update id="updateByParam" parameterType="com.machugit.entity.query.VideoPlayHistoryQuery">
		 UPDATE video_play_history h
 		 <set>
			<if test="bean.historyId != null">
				 history_id = #{bean.historyId},
			</if>
			<if test="bean.videoId != null">
				 video_id = #{bean.videoId},
			</if>
			<if test="bean.userId != null">
				 user_id = #{bean.userId},
			</if>
			<if test="bean.fileId != null">
				 file_id = #{bean.fileId},
			</if>
			<if test="bean.updateTime != null">
				 update_time = #{bean.updateTime},
			</if>
 		 </set>
 		 <include refid="query_condition" />
	</update>

	<!--多条件删除-->
	<delete id="deleteByParam">
		 delete h from video_play_history h
 		 <include refid="query_condition" />
	</delete>

	<!-- 根据HistoryId修改-->
	<update id="updateByHistoryId" parameterType="com.machugit.entity.po.VideoPlayHistory">
		 UPDATE video_play_history
 		 <set>
			<if test="bean.videoId != null">
				 video_id = #{bean.videoId},
			</if>
			<if test="bean.userId != null">
				 user_id = #{bean.userId},
			</if>
			<if test="bean.fileId != null">
				 file_id = #{bean.fileId},
			</if>
			<if test="bean.updateTime != null">
				 update_time = #{bean.updateTime},
			</if>
 		 </set>
 		 where history_id=#{historyId}
	</update>

	<!-- 根据HistoryId删除-->
	<delete id="deleteByHistoryId">
		delete from video_play_history where history_id=#{historyId}
	</delete>

	<!-- 根据HistoryId获取对象-->
	<select id="selectByHistoryId" resultMap="base_result_map" >
		select <include refid="base_column_list" /> from video_play_history h where history_id=#{historyId}
	</select>

	<!-- 根据UserId获取对象-->
	<select id="selectByUserId" resultMap="base_result_map" >
		select <include refid="base_column_list" /> from video_play_history h where user_id=#{userId}
	</select>

</mapper>
