	<!--实体映射-->
	<resultMap id="base_result_map" type="com.machugit.entity.po.CoinTransactionLog">
		<!--日志id-->
		<result column="log_id" property="logId"  />
		<!--用户id-->
		<result column="user_id" property="userId"  />
		<!--视频id-->
		<result column="video_id" property="videoId"  />
		<!--硬币数量-->
		<result column="coin_amount" property="coinAmount"  />
		<!--来源类型-->
		<result column="source_type" property="sourceType"  />
		<!--创建时间-->
		<result column="create_time" property="createTime"  />
	</resultMap>


	<!-- 通用查询结果列-->
	<sql id="base_column_list">
		 c.log_id,c.user_id,c.video_id,c.coin_amount,c.source_type,
		 c.create_time
	</sql>

	<sql id="base_condition_filed">
			<if test="query.logId != null">
				 and  c.log_id = #{query.logId}
			</if>
			<if test="query.userId != null and query.userId!=''">
				 and  c.user_id = #{query.userId}
			</if>
			<if test="query.videoId != null and query.videoId!=''">
				 and  c.video_id = #{query.videoId}
			</if>
			<if test="query.coinAmount != null">
				 and  c.coin_amount = #{query.coinAmount}
			</if>
			<if test="query.sourceType != null">
				 and  c.source_type = #{query.sourceType}
			</if>
			<if test="query.createTime != null and query.createTime!=''">
				 <![CDATA[ and  c.create_time=str_to_date(#{query.createTime}, '%Y-%m-%d') ]]>
			</if>
	</sql>

	<!-- 通用查询条件列-->
	<sql id="query_condition">
	 <where>
			<include refid="base_condition_filed" />
			<if test="query.userIdFuzzy!= null  and query.userIdFuzzy!=''">
				 and  c.user_id like concat('%', #{query.userIdFuzzy}, '%')
			</if>
			<if test="query.videoIdFuzzy!= null  and query.videoIdFuzzy!=''">
				 and  c.video_id like concat('%', #{query.videoIdFuzzy}, '%')
			</if>
			<if test="query.createTimeStart!= null and query.createTimeStart!=''">
				 <![CDATA[ and  c.create_time>=str_to_date(#{query.createTimeStart}, '%Y-%m-%d') ]]>
			</if>
			<if test="query.createTimeEnd!= null and query.createTimeEnd!=''">
				 <![CDATA[ and  c.create_time< date_sub(str_to_date(#{query.createTimeEnd},'%Y-%m-%d'),interval -1 day) ]]>
			</if>
	 </where>
	</sql>

	<!-- 查询集合-->
	<select id="selectList" resultMap="base_result_map" >
		 SELECT <include refid="base_column_list" /> FROM coin_transaction_log c <include refid="query_condition" />
		 <if test="query.orderBy!=null">
			 order by ${query.orderBy}
		 </if>
		 <if test="query.simplePage!=null">
			 limit #{query.simplePage.start},#{query.simplePage.end}
		 </if>
	</select>

