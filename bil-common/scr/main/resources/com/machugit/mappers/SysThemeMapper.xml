			</if>
			<if test="bean.status != null">
				 status = #{bean.status},
			</if>
 		 </set>
 		 <include refid="query_condition" />
	</update>

	<!--多条件删除-->
	<delete id="deleteByParam">
		 delete t from sys_theme t
 		 <include refid="query_condition" />
	</delete>

	<!-- 根据Id修改 -->
	<update id="updateById" parameterType="com.machugit.entity.po.SysTheme">
		 UPDATE sys_theme
 		 <set>
			<if test="bean.themeName != null">
				 theme_name = #{bean.themeName},
			</if>
			<if test="bean.gradient != null">
				 gradient = #{bean.gradient},
			</if>
			<if test="bean.primaryColor != null">
				 primary_color = #{bean.primaryColor},
			</if>
			<if test="bean.sort != null">
