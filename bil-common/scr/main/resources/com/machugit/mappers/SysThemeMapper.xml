			</if>
			<if test="bean.status != null">
				 status = #{bean.status},
			</if>
 		 </set>
 		 where theme_id=#{id}
	</update>

	<!-- 根据Id删除 -->
	<delete id="deleteById">
		delete from sys_theme where theme_id=#{id}
	</delete>

	<!-- 根据PrimaryKey获取对象 -->
	<select id="selectById" resultMap="base_result_map" >
		select <include refid="base_column_list" /> from sys_theme t where theme_id=#{id}
	</select>

</mapper>
