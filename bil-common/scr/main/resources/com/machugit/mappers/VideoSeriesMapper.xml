<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.machugit.mappers.VideoSeriesMapper">

	<!--实体映射-->
	<resultMap id="base_result_map" type="com.machugit.entity.po.VideoSeries">
		<!--系列id-->
		<result column="series_id" property="seriesId"  />
		<!--用户id-->
		<result column="user_id" property="userId"  />
		<!--系列名称-->
		<result column="series_name" property="seriesName"  />
		<!--系列描述-->
		<result column="series_description" property="seriesDescription"  />
		<!--排序-->
		<result column="sort" property="sort"  />
		<!--更新时间-->
		<result column="update_time" property="updateTime"  />
	</resultMap>


	<!-- 通用查询结果列-->
	<sql id="base_column_list">
		 s.series_id,s.user_id,s.series_name,s.series_description,s.sort,s.update_time
	</sql>

	<sql id="base_condition_filed">
			<if test="query.seriesId != null">
				 and  s.series_id = #{query.seriesId}
			</if>
			<if test="query.userId != null and query.userId!=''">
				 and  s.user_id = #{query.userId}
			</if>
			<if test="query.seriesName != null and query.seriesName!=''">
				 and  s.series_name = #{query.seriesName}
			</if>
			<if test="query.seriesDescription != null and query.seriesDescription!=''">
				 and  s.series_description = #{query.seriesDescription}
			</if>
			<if test="query.sort != null">
				 and  s.sort = #{query.sort}
			</if>
			<if test="query.updateTime != null and query.updateTime!=''">
				 <![CDATA[ and  s.update_time=str_to_date(#{query.updateTime}, '%Y-%m-%d') ]]>
			</if>
	</sql>

	<!-- 通用查询条件列-->
	<sql id="query_condition">
	 <where>
			<include refid="base_condition_filed" />
			<if test="query.seriesNameFuzzy!= null  and query.seriesNameFuzzy!=''">
				 and  s.series_name like concat('%', #{query.seriesNameFuzzy}, '%')
			</if>
			<if test="query.seriesDescriptionFuzzy!= null  and query.seriesDescriptionFuzzy!=''">
				 and  s.series_description like concat('%', #{query.seriesDescriptionFuzzy}, '%')
			</if>
			<if test="query.updateTimeStart!= null and query.updateTimeStart!=''">
				 <![CDATA[ and  s.update_time>=str_to_date(#{query.updateTimeStart}, '%Y-%m-%d') ]]>
			</if>
			<if test="query.updateTimeEnd!= null and query.updateTimeEnd!=''">
				 <![CDATA[ and  s.update_time< date_sub(str_to_date(#{query.updateTimeEnd},'%Y-%m-%d'),interval -1 day) ]]>
			</if>
	 </where>
	</sql>

	<!-- 查询集合-->
	<select id="selectList" resultMap="base_result_map" >
		 SELECT <include refid="base_column_list" /> FROM video_series s <include refid="query_condition" />
		 <if test="query.orderBy!=null">
			 order by ${query.orderBy}
		 </if>
		 <if test="query.simplePage!=null">
			 limit #{query.simplePage.start},#{query.simplePage.end}
		 </if>
	</select>

	<!-- 查询数量-->
	<select id="selectCount" resultType="java.lang.Integer" >
		 SELECT count(1) FROM video_series s <include refid="query_condition" />
	</select>

	<!-- 插入 （匹配有值的字段）-->
	<insert id="insert" parameterType="com.machugit.entity.po.VideoSeries">
		 INSERT INTO video_series
		 <trim prefix="(" suffix=")" suffixOverrides="," >
			<if test="bean.seriesId != null">
				 series_id,
			</if>
			<if test="bean.userId != null">
				 user_id,
			</if>
			<if test="bean.seriesName != null">
				 series_name,
			</if>
			<if test="bean.seriesDescription != null">
				 series_description,
			</if>
			<if test="bean.sort != null">
				 sort,
			</if>
			<if test="bean.updateTime != null">
				 update_time,
			</if>
		 </trim>
		 <trim prefix="values (" suffix=")" suffixOverrides="," >
			<if test="bean.seriesId!=null">
				 #{bean.seriesId},
			</if>
			<if test="bean.userId!=null">
				 #{bean.userId},
			</if>
			<if test="bean.seriesName!=null">
				 #{bean.seriesName},
			</if>
			<if test="bean.seriesDescription!=null">
				 #{bean.seriesDescription},
			</if>
			<if test="bean.sort!=null">
				 #{bean.sort},
			</if>
			<if test="bean.updateTime!=null">
				 #{bean.updateTime},
			</if>
		 </trim>
	</insert>

	<!-- 插入或者更新 （匹配有值的字段）-->
	<insert id="insertOrUpdate" parameterType="com.machugit.entity.po.VideoSeries">
		 INSERT INTO video_series
		 <trim prefix="(" suffix=")" suffixOverrides=",">
			<if test="bean.seriesId != null">
				 series_id,
			</if>
			<if test="bean.userId != null">
				 user_id,
			</if>
			<if test="bean.seriesName != null">
				 series_name,
			</if>
			<if test="bean.seriesDescription != null">
				 series_description,
			</if>
			<if test="bean.sort != null">
				 sort,
			</if>
			<if test="bean.updateTime != null">
				 update_time,
			</if>
		 </trim>
		 <trim prefix="values (" suffix=")" suffixOverrides=",">
			<if test="bean.seriesId!=null">
				 #{bean.seriesId},
			</if>
			<if test="bean.userId!=null">
				 #{bean.userId},
			</if>
			<if test="bean.seriesName!=null">
				 #{bean.seriesName},
			</if>
			<if test="bean.seriesDescription!=null">
				 #{bean.seriesDescription},
			</if>
			<if test="bean.sort!=null">
				 #{bean.sort},
			</if>
			<if test="bean.updateTime!=null">
				 #{bean.updateTime},
			</if>
		 </trim>
		 on DUPLICATE key update
		 <trim prefix="" suffix="" suffixOverrides=",">
			<if test="bean.seriesId!=null">
				 series_id = VALUES(series_id),
			</if>
			<if test="bean.userId!=null">
				 user_id = VALUES(user_id),
			</if>
			<if test="bean.seriesName!=null">
				 series_name = VALUES(series_name),
			</if>
			<if test="bean.seriesDescription!=null">
				 series_description = VALUES(series_description),
			</if>
			<if test="bean.sort!=null">
				 sort = VALUES(sort),
			</if>
			<if test="bean.updateTime!=null">
				 update_time = VALUES(update_time),
			</if>
		 </trim>
	</insert>

	<!-- 添加 （批量插入）-->
	<insert id="insertBatch" parameterType="com.machugit.entity.po.VideoSeries">
		 INSERT INTO video_series(
			 series_id,
			 user_id,
			 series_name,
			 series_description,
			 sort,
			 update_time
		 )values
		 <foreach collection="list" item="item" separator=",">
			 (
				 #{item.seriesId},
				 #{item.userId},
				 #{item.seriesName},
				 #{item.seriesDescription},
				 #{item.sort},
				 #{item.updateTime}
			 )
		 </foreach>
	</insert>

	<!-- 批量新增修改 （批量插入）-->
	<insert id="insertOrUpdateBatch" parameterType="com.machugit.entity.po.VideoSeries">
		 INSERT INTO video_series(
			 series_id,
			 user_id,
			 series_name,
			 series_description,
			 sort,
			 update_time
