			 )
		 </foreach>
			on DUPLICATE key update
			series_id = VALUES(series_id),
			user_id = VALUES(user_id),
			series_name = VALUES(series_name),
			series_description = VALUES(series_description),
			sort = VALUES(sort),
			update_time = VALUES(update_time)
	</insert>

	<!--多条件修改-->
	<update id="updateByParam" parameterType="com.machugit.entity.query.VideoSeriesQuery">
		 UPDATE video_series s
 		 <set>
			<if test="bean.seriesId != null">
				 series_id = #{bean.seriesId},
			</if>
			<if test="bean.userId != null">
				 user_id = #{bean.userId},
			</if>
			<if test="bean.seriesName != null">
				 series_name = #{bean.seriesName},
			</if>
			<if test="bean.seriesDescription != null">
				 series_description = #{bean.seriesDescription},
			</if>
			<if test="bean.sort != null">
				 sort = #{bean.sort},
			</if>
			<if test="bean.updateTime != null">
				 update_time = #{bean.updateTime},
			</if>
 		 </set>
 		 <include refid="query_condition" />
	</update>

	<!--多条件删除-->
	<delete id="deleteByParam">
		 delete s from video_series s
 		 <include refid="query_condition" />
	</delete>

	<!-- 根据SeriesId修改-->
	<update id="updateBySeriesId" parameterType="com.machugit.entity.po.VideoSeries">
		 UPDATE video_series
 		 <set>
			<if test="bean.userId != null">
				 user_id = #{bean.userId},
			</if>
			<if test="bean.seriesName != null">
				 series_name = #{bean.seriesName},
			</if>
			<if test="bean.seriesDescription != null">
				 series_description = #{bean.seriesDescription},
			</if>
			<if test="bean.sort != null">
				 sort = #{bean.sort},
			</if>
			<if test="bean.updateTime != null">
				 update_time = #{bean.updateTime},
			</if>
 		 </set>
 		 where series_id=#{seriesId}
	</update>

	<!-- 根据SeriesId删除-->
	<delete id="deleteBySeriesId">
		delete from video_series where series_id=#{seriesId}
	</delete>

	<!-- 根据PrimaryKey获取对象-->
	<select id="selectBySeriesId" resultMap="base_result_map" >
		select <include refid="base_column_list" /> from video_series s where series_id=#{seriesId}
	</select>

	<!-- 根据UserId修改-->
	<update id="updateByUserId" parameterType="com.machugit.entity.po.VideoSeries">
		 UPDATE video_series
 		 <set>
			<if test="bean.seriesId != null">
				 series_id = #{bean.seriesId},
			</if>
			<if test="bean.seriesName != null">
				 series_name = #{bean.seriesName},
			</if>
			<if test="bean.seriesDescription != null">
				 series_description = #{bean.seriesDescription},
			</if>
			<if test="bean.sort != null">
				 sort = #{bean.sort},
			</if>
			<if test="bean.updateTime != null">
				 update_time = #{bean.updateTime},
			</if>
 		 </set>
 		 where user_id=#{userId}
	</update>

	<!-- 根据UserId删除-->
	<delete id="deleteByUserId">
		delete from video_series where user_id=#{userId}
	</delete>

	<!-- 根据PrimaryKey获取对象-->
	<select id="selectByUserId" resultMap="base_result_map" >
		select <include refid="base_column_list" /> from video_series s where user_id=#{userId}
